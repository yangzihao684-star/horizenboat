{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://horizenboat.online/api/v1/schema.json",
  "title": "HorizenBoat Work Package",
  "description": "单部作品的完整防 OOC 数据包。keywords / triggers 不是注释，而是 MCP 审查引擎的触发词。",
  "type": "object",
  "required": ["schema_version", "work_id", "title", "category", "tags", "world_laws", "timelines", "characters", "brainstorm_hooks"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "work_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "title": { "type": "string" },
    "title_en": { "type": "string" },
    "type": { "enum": ["fanfic", "original"] },
    "type_label": { "type": "string" },
    "category": { "type": "string" },
    "author": { "type": "string" },
    "tagline": { "type": "string" },
    "summary": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "difficulty": { "enum": ["low", "medium", "high"] },
    "spoiler_warning": { "type": "boolean" },
    "updated_at": { "type": "string" },
    "rights_note": { "type": "string" },
    "world_laws": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "title", "law", "enforcement", "keywords", "severity"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "law": { "type": "string" },
          "enforcement": { "type": "string" },
          "keywords": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "severity": { "$ref": "#/$defs/severity" }
        }
      }
    },
    "style_guide": {
      "type": "object",
      "properties": {
        "voice": { "type": "string" },
        "pacing": { "type": "string" },
        "banned_words": { "type": "array", "items": { "type": "string" } },
        "required_terms": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["term", "note"],
            "properties": { "term": { "type": "string" }, "note": { "type": "string" } }
          }
        },
        "vocabulary_notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "timelines": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {
        "type": "object",
        "required": ["id", "label", "range", "order", "status_quo", "power_ceiling", "knowledge_boundaries", "forbidden_events"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "range": { "type": "string" },
          "order": { "type": "number" },
          "note": { "type": "string" },
          "status_quo": { "type": "string" },
          "power_ceiling": { "type": "string" },
          "power_ceiling_triggers": { "type": "array", "items": { "type": "string" } },
          "knowledge_boundaries": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "forbidden_events": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "label", "because", "keywords", "severity"],
              "properties": {
                "id": { "type": "string" },
                "label": { "type": "string" },
                "because": { "type": "string" },
                "keywords": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
                "severity": { "$ref": "#/$defs/severity" }
              }
            }
          }
        }
      }
    },
    "characters": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {
        "type": "object",
        "required": ["id", "name", "role", "pathway", "drive", "personality_core", "speech_pattern", "addressing_matrix", "dialogue_samples", "ooc_taboos"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "name_en": { "type": "string" },
          "aliases": { "type": "array", "items": { "type": "string" } },
          "role": { "type": "string" },
          "pathway": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "drive": { "type": "string" },
          "personality_core": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "speech_pattern": { "type": "string" },
          "addressing_matrix": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["target", "form"],
              "properties": {
                "target": { "type": "string" },
                "form": { "type": "string" },
                "note": { "type": "string" }
              }
            }
          },
          "dialogue_samples": {
            "type": "array",
            "minItems": 3,
            "maxItems": 5,
            "items": {
              "type": "object",
              "required": ["text", "type"],
              "properties": {
                "text": { "type": "string" },
                "type": { "enum": ["canon", "style"] },
                "note": { "type": "string" }
              }
            }
          },
          "ooc_taboos": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["rule", "triggers", "severity"],
              "properties": {
                "rule": { "type": "string" },
                "triggers": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
                "severity": { "$ref": "#/$defs/severity" }
              }
            }
          }
        }
      }
    },
    "brainstorm_hooks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["hook_id", "title", "premise", "ripple_questions"],
        "properties": {
          "hook_id": { "type": "string" },
          "title": { "type": "string" },
          "premise": { "type": "string" },
          "ripple_questions": { "type": "array", "items": { "type": "string" }, "minItems": 3, "maxItems": 3 }
        }
      }
    },
    "integration": {
      "type": "object",
      "properties": {
        "recommended_timeline": { "type": "string" },
        "recommended_characters": { "type": "array", "items": { "type": "string" } },
        "sample_audit_plot": { "type": "string" }
      }
    }
  },
  "$defs": {
    "severity": { "enum": ["block", "warn"], "description": "block=硬冲突必须改，warn=需要修正" }
  }
}
